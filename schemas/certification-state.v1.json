{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/forge/certification-state.v1.json",
  "title": "AGENT-ENTITY Forge Certification State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_entity_ref",
    "state",
    "history",
    "grants_authority",
    "reputation_is_authority"
  ],
  "$defs": {
    "state": {
      "enum": [
        "UNCERTIFIED",
        "CANDIDATE",
        "CERTIFIED",
        "PRODUCTION_APPROVED",
        "RESTRICTED",
        "REVOKED"
      ]
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "properties": {
    "agent_entity_ref": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_state",
          "to_state",
          "at"
        ],
        "properties": {
          "from_state": {
            "$ref": "#/$defs/state"
          },
          "to_state": {
            "$ref": "#/$defs/state"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "$ref": "#/$defs/nullable_string"
          },
          "aegis_decision_ref": {
            "$ref": "#/$defs/nullable_string"
          },
          "human_approval_ref": {
            "$ref": "#/$defs/nullable_string"
          }
        },
        "if": {
          "properties": {
            "to_state": {
              "const": "PRODUCTION_APPROVED"
            }
          }
        },
        "then": {
          "anyOf": [
            {
              "properties": {
                "aegis_decision_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "aegis_decision_ref"
              ]
            },
            {
              "properties": {
                "human_approval_ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "human_approval_ref"
              ]
            }
          ]
        }
      }
    },
    "grants_authority": {
      "const": false
    },
    "reputation_is_authority": {
      "const": false
    }
  }
}
