{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/forge/proof-envelope.v1.json",
  "title": "AGENT-ENTITY Forge Proof Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_id",
    "proof_class",
    "agent_entity_ref",
    "evidence_refs",
    "verifier_ref",
    "created_at",
    "status"
  ],
  "properties": {
    "proof_id": {
      "type": "string"
    },
    "proof_class": {
      "type": "string"
    },
    "agent_entity_ref": {
      "type": "string"
    },
    "intent_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "mandate_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_envelope_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verifier_ref": {
      "type": "string"
    },
    "policy_version_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_attestation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "DISPUTED",
        "REVOKED",
        "EXPIRED",
        "FAILED"
      ]
    },
    "grants_authority": {
      "const": false
    }
  }
}
